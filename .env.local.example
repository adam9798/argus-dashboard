NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to "true" only once the device serves HTTPS (e.g. a self-signed
# cert on the Pi). Leave unset/false for plain-HTTP LAN deployment —
# browsers won't set a Secure cookie over HTTP, so flipping this on
# without TLS breaks login entirely. See lib/config.ts.
AUTH_COOKIE_SECURE=false
# Every node the dashboard can switch between (server-side only). "Name=URL",
# comma separated. Unset = the single node at NEXT_PUBLIC_API_BASE_URL.
ARGUS_NODES=Node A=http://10.0.0.140:8000,Node B=http://10.0.0.128:8000,Node C=http://argus-c.local:8000
