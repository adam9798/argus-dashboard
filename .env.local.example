NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to "true" only once the device serves HTTPS (e.g. a self-signed
# cert on the Pi). Leave unset/false for plain-HTTP LAN deployment —
# browsers won't set a Secure cookie over HTTP, so flipping this on
# without TLS breaks login entirely. See lib/config.ts.
AUTH_COOKIE_SECURE=false
# Every node the dashboard can switch between (server-side only). "Name=URL",
# comma separated. Unset = the single node at NEXT_PUBLIC_API_BASE_URL.
ARGUS_NODES=Node A=http://10.0.0.140:8000,Node B=http://10.0.0.128:8000,Node C=http://argus-c.local:8000

# Sign-in. People sign in with a node's username and password; the dashboard
# signs the resulting cookie so it cannot be forged. The signing key is made
# automatically in data/session-secret (delete it and restart to sign everyone
# out). Set this only to choose the key yourself, 32+ characters.
# ARGUS_SESSION_SECRET=

# Discord alerts. Text only: class, zone, node, time and confidence, never an
# image (proposal CON-2). Create the webhook in Discord: Server Settings ->
# Integrations -> Webhooks. Keep the real URL in .env.local, never in git.
# ARGUS_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# Link shown in the alert. Unset = this computer's address on whatever
# network it is on.
# ARGUS_DASHBOARD_URL=http://192.168.1.8:3002
# Node discovery. The dashboard searches the local network for nodes at
# start-up, on a network change, when a node stops answering, and from the
# "Find nodes" button. Nodes are matched by the NODE_NAME each Pi reports, so
# give every Pi its own. ARGUS_NODES above is then optional.
# ARGUS_DISCOVERY=off
# ARGUS_NODE_PORT=8000
# ARGUS_NODES_FILE=
# Only needed if a node refuses unauthenticated event reads. A node locks
# logins after repeated failures, so the watcher logs in rarely.
# ARGUS_ALERT_USER=
# ARGUS_ALERT_PASS=
# Where alert state and the dead-letter log are kept (default data/alerts).
# ARGUS_ALERTS_DATA_DIR=
