NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to "true" only once the device serves HTTPS (e.g. a self-signed
# cert on the Pi). Leave unset/false for plain-HTTP LAN deployment —
# browsers won't set a Secure cookie over HTTP, so flipping this on
# without TLS breaks login entirely. See lib/config.ts.
AUTH_COOKIE_SECURE=false
# Every node the dashboard shows, in the tab bar and on the "All nodes" page
# (server-side only). "Label|Name=URL", comma separated, one line. The label
# (optional) is what the console shows. Adding a node = appending
# ",Camera N|Node X=http://<ip>:8000". A node that is down, or has no
# camera, still gets a card. Unset = the single node at NEXT_PUBLIC_API_BASE_URL.
ARGUS_NODES=Camera 1|Node A=http://NODE_A_IP:8000,Camera 2|Node B=http://NODE_B_IP:8000

# The one dashboard login. Required: there is no built-in password.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
# Signs the session cookie. Required, 32+ random characters, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sign-in is refused while these values still start with "change-me".
DASHBOARD_SESSION_SECRET=change-me-to-a-long-random-string

# The login the dashboard server uses for the nodes; never sent to the
# browser. A default for every node, then per-node overrides keyed by the
# node name (or label): "Name=user:pass", comma separated.
ARGUS_NODE_USER=admin
ARGUS_NODE_PASSWORD=change-me
# ARGUS_NODE_CREDS=Node A=admin:change-me,Node B=admin:other-password
